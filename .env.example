# Copy this file to .env and fill in your own values. Never commit .env.

# Gnani Vachana API key (sent as X-API-Key-ID header)
GNANI_API_KEY=

# LLM used for translation
LLM_PROVIDER=gemini
LLM_API_KEY=
# Telegram bot token from @BotFather (/newbot). Leave empty to run without the bot.
TELEGRAM_BOT_TOKEN=

# Optional: override the model (default gemini-3.5-flash-lite) and the backup used when it is overloaded
LLM_MODEL=
LLM_FALLBACK_MODEL=
