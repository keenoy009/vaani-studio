# Copy this file to .env and fill in your own values. Never commit .env.

# Gnani Vachana API key (sent as X-API-Key-ID header)
GNANI_API_KEY=

# LLM used for translation
LLM_PROVIDER=gemini
LLM_API_KEY=
# Telegram bot token from @BotFather (/newbot). Leave empty to run without the bot.
TELEGRAM_BOT_TOKEN=

# --- Accounts (sign-in) ---
# The FIRST account created becomes the workspace owner (and sees the bot's videos and any older videos).
# Set to false to close sign-up once your team has accounts:
ALLOW_SIGNUP=true
# Set to true when running behind a reverse proxy (nginx, Caddy, a cloud load balancer), so rate limits use the real visitor address:
TRUST_PROXY=false
# Extra websites allowed to call the API from a browser (comma-separated), e.g. https://studio.example.com
ALLOWED_ORIGINS=
# Set to production when deployed over HTTPS: session cookies are then marked Secure.
NODE_ENV=

# Optional: override the model (default gemini-3.5-flash-lite) and the backup used when it is overloaded
LLM_MODEL=
LLM_FALLBACK_MODEL=
